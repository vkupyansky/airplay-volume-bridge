--- a/utilities/debug.c
+++ b/utilities/debug.c
@@ -32,7 +32,38 @@
 #include <stdlib.h>
 #include <string.h>
 #include <syslog.h>
-#include <unistd.h> // for usleep()
+#include <unistd.h> // for usleep()
+
+#ifdef CONFIG_COREAUDIO
+#include <os/log.h>
+
+static pthread_once_t receiver_log_once = PTHREAD_ONCE_INIT;
+static os_log_t receiver_log;
+
+static void create_receiver_log(void) {
+  receiver_log = os_log_create("local.airplay-volume-bridge", "receiver");
+}
+#endif
+
+static void write_receiver_log(int priority, const char *format, const char *message) {
+#ifdef CONFIG_COREAUDIO
+  pthread_once(&receiver_log_once, create_receiver_log);
+  os_log_type_t type = OS_LOG_TYPE_DEFAULT;
+  if (priority == LOG_ERR)
+    type = OS_LOG_TYPE_FAULT;
+  else if (priority == LOG_WARNING)
+    type = OS_LOG_TYPE_ERROR;
+  else if (priority == LOG_DEBUG)
+    type = OS_LOG_TYPE_DEBUG;
+  // значения аргументов могут содержать адреса, пути и метаданные отправителя
+  os_log_with_type(receiver_log, type, "%{public}s | %{private}s", format, message);
+#else
+  (void)priority;
+  (void)format;
+#endif
+  // launchd направляет stderr в /dev/null; ручной запуск сохраняет диагностику
+  fprintf(stderr, "%s\n", message);
+}
 
 static int debuglev = 0;
 int debugger_show_elapsed_time = 0;
